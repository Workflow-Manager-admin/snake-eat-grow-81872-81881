<resources>
    <style name="AlertDialogDark" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">@android:color/background_dark</item>
        <item name="android:textColorPrimary">#fbc02d</item>
        <item name="android:windowBackground">#262626</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
    </style>
    <style name="PositiveButtonStyle" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">#388e3c</item>
    </style>
    <style name="NegativeButtonStyle" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">#d32f2f</item>
    </style>
</resources>
